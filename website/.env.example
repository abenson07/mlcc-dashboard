# Public site URL (used for canonical links / sitemap). Set per Vercel environment.
PUBLIC_SITE_URL=http://localhost:4321

# Base URL of the dashboard's Next API (membership checkout, open-routes signup, shop).
# The dashboard must allow this site's origin via its CORS allowlist.
PUBLIC_API_BASE=http://localhost:3000

# Sanity (filled in once the project exists)
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
# Read token with viewer access, server-only. Needed for draft/preview (Presentation).
SANITY_API_READ_TOKEN=
