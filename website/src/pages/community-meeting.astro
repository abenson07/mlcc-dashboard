---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionLabel from "../components/SectionLabel.astro";
import CtaSection from "../components/CtaSection.astro";
import { ed } from "../lib/edit";
import { getLivestream, livestreamEmbedUrl } from "../lib/livestream";
import { renderBody } from "../lib/sanity";

const edit = Boolean(Astro.locals.edit);
const meeting = await getLivestream(edit);
if (!meeting) return new Response("Not found", { status: 404 });
const bodyHtml = renderBody(meeting.body, "meeting");
---

<BaseLayout
  title={`${meeting.title} | Maple Leaf Community Council`}
  description={`Watch the live stream of the Maple Leaf Community Council's ${meeting.title}.`}
>
  <main>
    <section class="bg-sparkles-cream text-sparkles-navy">
      <div class="px-8 max-[767px]:px-4">
        <div class="mx-auto w-full max-w-[1800px] py-20 max-[767px]:py-16">
          <div class="mx-auto mb-12 flex max-w-[42.5rem] flex-col items-center gap-6 text-center max-[479px]:gap-4">
            <SectionLabel>Live stream</SectionLabel>
            <h1 {...ed(edit, meeting._id, "title", "text")} class="m-0 font-display text-[3.75rem] leading-16 font-bold tracking-[-0.15625rem] text-puget-night max-[767px]:text-[2.5rem] max-[767px]:leading-10 max-[767px]:tracking-[-0.0625rem]">{meeting.title}</h1>
            {(meeting.dateLabel || edit) && (
              <p {...ed(edit, meeting._id, "dateLabel", "text")} class="m-0 font-body text-xl leading-7 text-sparkles-muted max-[767px]:text-base max-[767px]:leading-6">{meeting.dateLabel}</p>
            )}
          </div>

          <div {...ed(edit, meeting._id, "youtubeId")} class="mx-auto mb-16 w-full max-w-[60rem] overflow-hidden rounded-[1.25rem] bg-sparkles-navy max-[767px]:mb-12">
            <div class="relative aspect-video w-full">
              <iframe
                src={livestreamEmbedUrl(meeting.youtubeId)}
                title={`${meeting.title} live stream`}
                class="absolute inset-0 h-full w-full border-0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                referrerpolicy="strict-origin-when-cross-origin"
                allowfullscreen
              ></iframe>
            </div>
          </div>

          <div class="mx-auto max-w-[35.25rem] font-body text-sparkles-navy max-[991px]:max-w-none">
            <div {...ed(edit, meeting._id, "body")} set:html={bodyHtml} />
            <p class="mb-4 text-base leading-6">
              <a href={`https://youtube.com/watch?v=${meeting.youtubeId}`} target="_blank" rel="noreferrer" class="font-bold text-sparkles-navy">Open on YouTube</a>
            </p>
          </div>
        </div>
      </div>
    </section>
    <CtaSection />
  </main>
</BaseLayout>
