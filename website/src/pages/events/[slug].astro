---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionLabel from "../../components/SectionLabel.astro";
import EventDetailsCard from "../../components/EventDetailsCard.astro";
import CtaSection from "../../components/CtaSection.astro";
import { imageSrc, renderBody } from "../../lib/sanity";
import { ed } from "../../lib/edit";
import { formatEventDate, getAllEvents, getRelatedEvents, type SanityEvent } from "../../lib/events";

const edit = Boolean(Astro.locals.edit);
const all: SanityEvent[] = await getAllEvents(edit);
const event = all.find((e) => e.slug === Astro.params.slug);
if (!event) return new Response("Event not found", { status: 404 });
const related = getRelatedEvents(all, event.slug, 2);

const isPortrait = event.imageAspect === "portrait";
const right = event.imagePosition === "right";
const imageOrder = right ? "order-2" : "order-1";
const bodyOrder = right ? "order-1" : "order-2";
const bodyAlign = right ? "justify-self-start" : "justify-self-end";

const hero = imageSrc(event.image, isPortrait ? 1200 : 2400, isPortrait ? 1600 : undefined);
const bodyHtml = renderBody(event.body) || `<p class="mb-4 text-base leading-6">${event.shortDescription ?? ""}</p>`;
---

<BaseLayout title={`${event.title} | Events`} description={event.shortDescription}>
  <main>
    <div class="bg-sparkles-cream text-sparkles-navy">
      <section class="bg-sparkles-cream">
        <div class="px-8 max-[767px]:px-4">
          <div class="mx-auto w-full max-w-[1800px]">
            <div class="py-20 max-[767px]:py-16">
              <div class="mb-16 flex flex-col items-start gap-12">
                <a href="/events" class="flex flex-row items-center gap-1 font-body text-base leading-[125%] text-sparkles-navy no-underline">
                  <span class="flex h-5 w-5 flex-none items-center justify-center">
                    <svg width="100%" height="100%" viewBox="0 0 20 20" fill="none"><path d="M15 10H5M5 10L10 5M5 10L10 15" stroke="currentColor" stroke-width="1px" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  </span>
                  <span>All events</span>
                </a>

                <div class="mx-auto flex max-w-[42.5rem] flex-col items-center justify-start gap-6 text-center max-[479px]:gap-4">
                  <div class="flex flex-wrap items-center justify-center gap-2">
                    <span {...ed(edit, event._id, "startsAt")}><SectionLabel>{formatEventDate(event.startsAt)}</SectionLabel></span>
                    {(event.category || edit) && <span {...ed(edit, event._id, "category", "text")}><SectionLabel>{event.category}</SectionLabel></span>}
                  </div>
                  <h1 {...ed(edit, event._id, "title", "text")} class="m-0 font-display text-[3.75rem] leading-16 font-bold tracking-[-0.15625rem] text-puget-night max-[767px]:text-[2.5rem] max-[767px]:leading-10 max-[767px]:tracking-[-0.0625rem]">{event.title}</h1>
                </div>
              </div>

              {hero && !isPortrait && (
                <div {...ed(edit, event._id, "image")} class="h-[30rem] w-full overflow-hidden rounded-2xl max-[991px]:h-[22.5rem] max-[767px]:h-[18.75rem] max-[479px]:h-[15.6rem]">
                  <img src={hero} alt="" class="h-full w-full object-cover" />
                </div>
              )}
            </div>
          </div>

          <div class="mx-auto w-full max-w-[1800px] pb-20 max-[767px]:pb-16">
            <div class="grid grid-cols-2 items-start justify-items-end gap-4 max-[991px]:grid-cols-1 max-[991px]:gap-16">
              {hero && isPortrait && (
                <div {...ed(edit, event._id, "image")} class={`w-full aspect-[3/4] overflow-hidden rounded-2xl ${imageOrder}`}>
                  <img src={hero} alt="" class="h-full w-full object-cover" />
                </div>
              )}

              <div class={`flex w-full max-w-[42.5rem] flex-col gap-16 max-[991px]:max-w-none ${isPortrait ? `${bodyOrder} ${bodyAlign}` : "justify-self-start"}`}>
                <div class="font-body text-sparkles-navy" {...ed(edit, event._id, "body")} set:html={bodyHtml} />
                {isPortrait && <EventDetailsCard event={event} edit={edit} />}
              </div>

              {!isPortrait && <EventDetailsCard event={event} edit={edit} />}
            </div>
          </div>
        </div>
      </section>

      <section class="bg-sparkles-cream">
        <div class="px-8 max-[767px]:px-4">
          <div class="mx-auto w-full max-w-[1800px]">
            <div class="py-20 max-[767px]:py-16">
              <div class="mb-8 mr-auto h-0 w-full border-b border-sparkles-navy/16"></div>
              {related.length > 0 && (
                <>
                  <div class="mb-16 flex flex-col items-start justify-start gap-4">
                    <SectionLabel>Upcoming</SectionLabel>
                    <h2 class="m-0 font-display text-[3rem] leading-[3.25rem] font-bold tracking-[-0.125rem] text-puget-night max-[767px]:text-[2rem] max-[767px]:leading-7 max-[767px]:tracking-[-0.031rem]">More events</h2>
                  </div>
                  <div class="grid grid-cols-2 gap-x-3 gap-y-16 max-[479px]:grid-cols-1">
                    {related.map((r) => (
                      <a href={`/events/${r.slug}`} class="flex w-full flex-col gap-4 text-sparkles-navy no-underline">
                        <div class="relative h-[25rem] w-full overflow-hidden rounded-2xl max-[991px]:h-[18.75rem] max-[767px]:h-[15.625rem] max-[479px]:h-[12.5rem] max-[479px]:rounded-lg">
                          <img loading="lazy" src={imageSrc(r.image, 1200, 800)} alt="" class="h-full w-full object-cover" />
                          <div class="absolute left-3 top-3 z-10"><SectionLabel>{formatEventDate(r.startsAt)}</SectionLabel></div>
                        </div>
                        <div class="flex flex-row items-center justify-between gap-5 max-[767px]:flex-col max-[767px]:items-start max-[767px]:justify-between">
                          <div class="font-display text-2xl leading-7 font-bold tracking-[-0.03125rem] text-puget-night">{r.title}</div>
                          <div class="flex flex-wrap items-stretch justify-end gap-2">{r.category && <SectionLabel>{r.category}</SectionLabel>}</div>
                        </div>
                      </a>
                    ))}
                  </div>
                </>
              )}
            </div>
          </div>
        </div>
      </section>
    </div>
    <CtaSection />
  </main>
</BaseLayout>
