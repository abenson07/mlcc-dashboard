---
import BaseLayout from "../layouts/BaseLayout.astro";
import { fetchPublished, UPCOMING_EVENTS_QUERY } from "../lib/sanity";

type UpcomingEvent = { title: string; slug: string; startsAt: string; locationName?: string };
const events = await fetchPublished<UpcomingEvent[]>(UPCOMING_EVENTS_QUERY);
---

<BaseLayout title="Maple Leaf Community Council">
  <main class="mx-auto max-w-3xl px-8 py-24">
    <img src="/logo_black.svg" alt="MLCC" class="mb-8 h-12" />
    <h1 class="font-display text-5xl text-puget-night">Maple Leaf Community Council</h1>
    <p class="mt-4 text-lg">Astro scaffold. Content comes from Sanity.</p>
    <h2 class="font-display mt-10 text-2xl">Upcoming events ({events.length})</h2>
    <ul class="mt-2 list-disc pl-6">
      {events.map((e) => <li>{e.title} — {new Date(e.startsAt).toLocaleDateString("en-US")}</li>)}
    </ul>
  </main>
</BaseLayout>
