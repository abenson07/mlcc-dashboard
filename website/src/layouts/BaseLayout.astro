---
import "../styles/global.css";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import EditBridge from "../components/EditBridge.astro";
import { getBannerItems } from "../lib/banner";

interface Props {
  title: string;
  description?: string;
}
const { title, description = "A volunteer-run community council connecting neighbors in Maple Leaf, Seattle, through events, advocacy, The Leaflet newsletter, and more." } = Astro.props;
const edit = Astro.locals.edit;
const bannerItems = await getBannerItems(Boolean(edit));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:site_name" content="Maple Leaf Community Council" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/og-image.png" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body data-edit-mode={edit ? "" : undefined} class="marketing-root min-h-full flex flex-col bg-sparkles-cream text-sparkles-navy font-body antialiased">
    <SiteNav bannerItems={bannerItems} />
    <div class="flex-1 bg-sparkles-cream pt-[6.75rem] max-[991px]:pt-[6.25rem]">
      <slot />
    </div>
    <SiteFooter />
    {edit && <EditBridge parentOrigin={edit.parent} token={edit.token} />}
  </body>
</html>
