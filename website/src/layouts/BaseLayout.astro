---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}
const { title, description = "Maple Leaf Community Council" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:image" content="/og-image.png" />
  </head>
  <body class="marketing-root">
    <slot />
  </body>
</html>
