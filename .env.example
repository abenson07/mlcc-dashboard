# Supabase Auth (admin login OTP) — configure in Supabase Dashboard, not via RESEND_* below:
# Authentication → SMTP (e.g. Resend), Email templates (Magic Link with {{ .Token }}), invited users only.
# App env: NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY (or publishable key), SUPABASE_SERVICE_ROLE_KEY (server only).

# Webflow Data API — Site banners CMS collection (MWO-239)
# Token needs CMS:read and CMS:write (and sites:read to run --list-sites).
# Use your Webflow site / Data API token — set ONE of these (same value; site token name is preferred):
WEBFLOW_SITE_API_TOKEN=
# WEBFLOW_API_TOKEN=
# Create the collection once: npm run webflow:setup-banners (see script header) or use Webflow Designer.
# After WEBFLOW_BANNERS_COLLECTION_ID is set: npm run webflow:verify-banners
# Site id — run: npm run webflow:setup-banners -- --list-sites. Required for CMS localization (banner publish; token needs sites:read) and for calendar event image uploads (assets API; token needs assets:write).
WEBFLOW_SITE_ID=
WEBFLOW_BANNERS_COLLECTION_ID=

# --- Webflow Volunteer Asks CMS (public site list; synced from Supabase) ---
# Create collection: npm run webflow:setup-volunteer-asks
# Then: npm run webflow:verify-volunteer-asks
# Same Webflow token as events/banners. Restart `npm run dev` after changing.
WEBFLOW_VOLUNTEER_ASKS_COLLECTION_ID=
# Secret for Supabase Database Webhook → POST /api/webhooks/supabase/volunteer-asks
# Header: x-volunteer-ask-webhook-secret: <this value>
# Tables: volunteer_asks, volunteers (INSERT/UPDATE/DELETE)
SUPABASE_VOLUNTEER_ASK_WEBHOOK_SECRET=

# --- Webflow Events CMS (admin calendar, /events, full event editor) ---
# Same token as above. Needs CMS read/write and publish. Featured image upload needs assets:write.
# New "Events" collection (recommended for a clean slate): npm run webflow:create-events-collection
# Or add fields to an existing collection: npm run webflow:setup-events-fields
# Then: npm run webflow:verify-events
# Override slug if "events" is taken: npm run webflow:create-events-collection -- --collection-slug events-v2
WEBFLOW_EVENTS_COLLECTION_ID=
# Committees collection id (Reference target for event → committee on the public site).
WEBFLOW_COMMITTEES_COLLECTION_ID=
# Schedule fields (recommended). Defaults in app: starts-at, ends-at. Override if your Designer slugs differ.
WEBFLOW_EVENT_CALENDAR_FIELD_SLUG=starts-at
WEBFLOW_EVENT_END_FIELD_SLUG=ends-at
# Optional: legacy/required combined start DateTime slug (mirrors starts-at on save). Default event-date-and-time; override or omit from collection to no-op.
# WEBFLOW_EVENT_EVENT_DATE_AND_TIME_SLUG=event-date-and-time
# Optional: create/update CMS items without calling the Webflow "publish" step (staged only)
# WEBFLOW_EVENTS_SKIP_PUBLISH=true
# Optional: bulk-create 2026 Silent Book Club items (third Sundays). See scripts/bulk-silent-book-club-2026.mjs — npm run webflow:bulk-silent-book-2026 -- --dry-run
# WEBFLOW_SILENT_BOOK_COMMITTEE_ITEM_ID=
# WEBFLOW_SILENT_BOOK_LOCATION_NAME=Watershed Pub
# WEBFLOW_SILENT_BOOK_START_HOUR=15
# WEBFLOW_SILENT_BOOK_END_HOUR=16
# Comma-separated Webflow field slugs to hide in the dashboard event modal (optional; committee-reference and committee-sponsor are always hidden)
# NEXT_PUBLIC_WEBFLOW_EVENT_HIDDEN_FIELD_SLUGS=
# Optional: Webflow slug for “External Organizer” (defaults to matching display name “External Organizer” if present)
# NEXT_PUBLIC_WEBFLOW_EVENT_EXTERNAL_ORGANIZER_SLUG=
# Optional: override event field slugs if Designer names differ (defaults match plan — see src/lib/webflow/event-field-slugs.ts)
# WEBFLOW_EVENT_FEATURED_IMAGE_SLUG=featured-image
# WEBFLOW_EVENT_COMMITTEE_FIELD_SLUG=committee
# WEBFLOW_EVENT_LOCATION_NAME_SLUG=location-name
# WEBFLOW_EVENT_BODY_SLUG=body
# Rich text long description (public detail). Default long-description.
# WEBFLOW_EVENT_LONG_DESCRIPTION_SLUG=long-description
# (see event-field-slugs.ts for the full list of WEBFLOW_EVENT_* overrides)

# --- Google Places API (New) — server-only; used by /api/places/* for event location search ---
# Enable “Places API (New)” on the key in Google Cloud Console.
GOOGLE_PLACES_API_KEY=

# Supabase service role — server / scripts only (never expose to the browser). Required for `npm run seed:businesses`.
# SUPABASE_SERVICE_ROLE_KEY=

# Postgres database password (Dashboard → Settings → Database). Required for `npm run migrate:businesses` — not the anon/service JWT.
# SUPABASE_DB_PASSWORD=
# Or paste the full connection URI instead:
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# Optional: override default Webflow field slugs (message, link-url, active, expires-at, urgent, urgent-until, editor-notes)
# WEBFLOW_BANNER_FIELD_MESSAGE=
# WEBFLOW_BANNER_FIELD_LINK_URL=
# WEBFLOW_BANNER_FIELD_ACTIVE=
# WEBFLOW_BANNER_FIELD_EXPIRES_AT=
# WEBFLOW_BANNER_FIELD_URGENT=
# WEBFLOW_BANNER_FIELD_URGENT_UNTIL=
# WEBFLOW_BANNER_FIELD_EDITOR_NOTES=

# Linear (bug/feature feedback FAB)
# Create a personal API key at: https://linear.app/settings/api
LINEAR_API_KEY=
# Optional: override default team and project (defaults: Benson Team, MLCC Dashboard Features)
# LINEAR_TEAM_ID=
# LINEAR_PROJECT_ID=

# Resend (transactional email)
# Create an API key: https://resend.com/api-keys — add it to `.env.local` as RESEND_API_KEY (never commit real keys).
# Add/verify your domain in Resend; "from" must use that domain after DNS is verified.
RESEND_API_KEY=
# Optional default for `<from>` in send calls — e.g. `MLCC <hello@yourdomain.com>` (quotes optional in env files)
RESEND_FROM_EMAIL=
# Marketing broadcasts (Resend Segments). Example segment id:
# RESEND_MARKETING_SEGMENT_ID=014b84c4-a062-49b8-9601-e94c781ffac1
RESEND_MARKETING_SEGMENT_ID=

# Leaflet deliverer public respond links (HMAC signing)
LEAFLET_RESPONSE_SIGNING_SECRET=

# Optional: default URL encoded in membership QR on new leaflets
# NEXT_PUBLIC_MEMBERSHIP_JOIN_URL=https://yoursite.org/join

# Buffer (Communications → Social — Instagram/Facebook scheduling)
# Create an API key: https://publish.buffer.com/settings/api
BUFFER_API_TOKEN=
# Optional when multiple Buffer workspaces exist on the token:
# BUFFER_ORGANIZATION_ID=

# Slack (committee page signup notifications)
# https://api.slack.com/apps → your app → OAuth & Permissions
# Bot Token Scopes: chat:write, chat:write.public → Install to Workspace → Bot User OAuth Token
SLACK_BOT_TOKEN=
# Channel IDs (right-click channel → View channel details → ID at the bottom)
# Fallback used when a signup's committee doesn't match a channel below
SLACK_CHANNEL_STEERING=
SLACK_CHANNEL_NEWSLETTER=
SLACK_CHANNEL_EVENTS=
SLACK_CHANNEL_EMERGENCY_HUB=
SLACK_CHANNEL_COMMUNICATIONS=
SLACK_CHANNEL_ADVOCACY=
SLACK_CHANNEL_BUSINESS=
# Contact page form
SLACK_CHANNEL_CONTACT=
# Inbound Twilio SMS → Slack
SLACK_CHANNEL_TWILIO_SMS=
# Twilio (SMS webhook signature validation + API)
# Account SID (AC…) from Console; Auth Token for X-Twilio-Signature
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Optional API key (SK…) + secret for REST calls
TWILIO_API_KEY=
TWILIO_SECRET_KEY=

# --- Stripe (dashboard billing + public commerce landings) ---
# Secret key — server only. Create products: node scripts/stripe-setup-commerce-products.mjs
STRIPE_SECRET_KEY=
# Webhook signing secret — POST /api/webhooks/stripe (checkout.session.completed)
STRIPE_WEBHOOK_SECRET=
# Fundraiser Checkout (preset tiers — amounts fixed server-side)
STRIPE_DONATION_PRODUCT_ID=
STRIPE_PRICE_DONATION_10=
STRIPE_PRICE_DONATION_40=
STRIPE_PRICE_DONATION_100=
# T-shirt preorder (single price for all sizes)
STRIPE_TSHIRT_PRODUCT_ID=
STRIPE_TSHIRT_PRICE_ID=
# Or omit STRIPE_TSHIRT_PRICE_ID and set cents instead:
# STRIPE_TSHIRT_PRICE_CENTS=2500
# Merch shop (one flat price per product, regardless of size)
STRIPE_SHOP_PRODUCT_ID_2026_SHIRT=
STRIPE_SHOP_PRICE_ID_2026_SHIRT=
# STRIPE_SHOP_PRICE_CENTS_2026_SHIRT=2000
STRIPE_SHOP_PRODUCT_ID_HAT=
STRIPE_SHOP_PRICE_ID_HAT=
# STRIPE_SHOP_PRICE_CENTS_HAT=2200
STRIPE_SHOP_PRODUCT_ID_2025_SHIRT=
STRIPE_SHOP_PRICE_ID_2025_SHIRT=
# STRIPE_SHOP_PRICE_CENTS_2025_SHIRT=2200
# Membership checkout (self-serve, /membership/join — recurring or one-time)
# Optional: lets Stripe reporting roll amounts up by product; falls back to an
# inline product name if unset. Pricing itself lives in mlcc-website/data/membership-tiers.ts.
STRIPE_MEMBERSHIP_PRODUCT_ID_HOUSEHOLD=
STRIPE_MEMBERSHIP_PRODUCT_ID_INDIVIDUAL=
STRIPE_MEMBERSHIP_PRODUCT_ID_SENIOR=
STRIPE_MEMBERSHIP_PRODUCT_ID_STUDENT=
# Resend audience for the "weekly digest" opt-in — a separate list from RESEND_MARKETING_SEGMENT_ID
# (which the "monthly neighborhood updates" opt-in and /subscribe both use).
RESEND_WEEKLY_DIGEST_AUDIENCE_ID=

# Progress bar goal (cents), default $25,000
FUNDRAISER_GOAL_CENTS=2500000
# CORS allowlist for maple-leaf-landings (comma-separated origins)
MLCC_LANDING_ORIGINS=https://give.mapleleafcommunity.org,https://shop.mapleleafcommunity.org
# Optional: invoice list filters (existing dashboard billing)
# STRIPE_INVOICE_EXCLUDE_PRODUCT_IDS=
# STRIPE_INVOICE_INCLUDE_PRODUCT_IDS=

# Anthropic (marketing email draft / revision; event short + long copy; npm run webflow:rewrite-event-short-descriptions)
ANTHROPIC_API_KEY=
# Optional model override (default: claude-sonnet-4-6)
# ANTHROPIC_MODEL=
